#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

exec sbcl --noinform --non-interactive \
  --eval '(setf *load-verbose* nil *compile-verbose* nil)' \
  --eval '(require :asdf)' \
  --eval "(asdf:load-asd \"${PROJECT_ROOT}/ljson.asd\")" \
  --eval '(asdf:load-system :ljson :verbose nil)' \
  --eval '(ljson/main:cli-main)' \
  -- "$@"
